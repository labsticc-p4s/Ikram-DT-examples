@library("std", "7.8.162-stable");

@library("explorer", "7.8.19-stable");


type Bioreactor {
    reactorId: String;
    position: geo;
}


type StrainFamily {
    name:           String;
    muMax:          float;
    latency:        float;
    phMin: float; phOpt: float; phMax: float;
    tempMin: float; tempOpt: float; tempMax: float;
}


type InitialStrain{
    populationInit: float;
    populationMax:  float;
    family:  node<StrainFamily>;
}




type Experimentation{

    strain: node<InitialStrain>;
    reactor:  node<Bioreactor>;
    states: nodeTime<ExperimentationState>;


    //meta data
    populationModel: String;
    phModel: String;
    tempModel: String;

    //physical or sim
    source: String;
}

type ExperimentationState{
     ph:  float;
     temperature:  float;
     population:   float;
     mu:  float;
     gammaPh: float;
     gammaTemp: float;
     growthStatus: String;
}


var bioreactors_by_id: nodeIndex<String, node<Bioreactor>>;

@expose
fn bioreactor_save(bioreactorId: String){
    var existing = bioreactors_by_id.get(bioreactorId);
    if (existing != null) {
        return null;
    }

    var b = Bioreactor {
        reactorId: bioreactorId,
        position: geo { 0.0, 0.0 }
    };
    bioreactors_by_id.set(bioreactorId, node<Bioreactor>{b});
    println("bioreactor saved yopi");
}



var families_by_id: nodeIndex<String, node<StrainFamily>>;
var initial_strains_by_id: nodeIndex<String, node<InitialStrain>>;

var families_by_condId: nodeIndex<String, String>;


var families_keys: nodeList<String>;
var init_conds_keys: nodeList<String>;


@expose
fn family_save(strainId: String, name: String, muMax: float, latency: float,phMin: float, phOpt: float, phMax: float,tempMin: float, tempOpt: float, tempMax: float) {

    var family = StrainFamily {
        name: name, muMax: muMax, latency: latency,
        phMin: phMin, phOpt: phOpt, phMax: phMax,
        tempMin: tempMin, tempOpt: tempOpt, tempMax: tempMax
    };

    var existing = families_by_id.get(strainId);
    if (existing != null) {
        existing.set(family);
    } else {
        families_by_id.set(strainId, node<StrainFamily>{family});
        families_keys.add(strainId);

    }
    println("strain fam is saved");

}


@expose
fn get_all_families():  Array<Map<String, any?>>? {
    var results = Array<Map<String, any?>>{};

    for (var i = 0; i < families_keys.size(); i++) {
        var key = families_keys.get(i);
        var ref = families_by_id.get(key);
        if (ref == null) { continue; }
        var f = *ref;
        results.add(Map<String, any?>{
           "strainId": key,
           "name"    : f.name,
           "muMax"   : f.muMax,    "latency": f.latency,
           "phMin"   : f.phMin,    "phOpt"  : f.phOpt,   "phMax"  : f.phMax,
           "tempMin" : f.tempMin,  "tempOpt": f.tempOpt, "tempMax": f.tempMax
        });
    }
              // println("return all fam");
             //  println(results);


    return results;
}




@expose
fn save_initial_strain(condId: String, popInit: float, popMax: float, familyId: String) {

    var familyRef = families_by_id.get(familyId);

    if (familyRef == null) {
        println("Strain family not found, create one");
        return null;
    }


    var initial = InitialStrain {
        populationInit: popInit,
        populationMax:  popMax,
        family:         familyRef
    };
    var existing = initial_strains_by_id.get(condId);
    if (existing != null) {
        existing.set(initial);
    } else {
        initial_strains_by_id.set(condId, node<InitialStrain>{initial});
        init_conds_keys.add(condId);
    }
    println("Initial strain created");

}




@expose
fn get_all_init_conds(): Array<Map<String, any?>>?{
    var results = Array<Map<String, any?>>{};

    for (var i = 0; i < init_conds_keys.size(); i++) {
        var key = init_conds_keys.get(i);
        var ref = initial_strains_by_id.get(key);
        if (ref == null) { continue; }
        var s = *ref;
        var f = *s.family;
        results.add(Map<String, any?>{
           "condId"        : key,
           "populationInit": s.populationInit,
           "populationMax" : s.populationMax,
           "familyId"      : families_keys.get(0)
        });
    }


    return results;
}


@expose
fn get_initial_strain(condId: String): Map<String, any?>? {

    var ref = initial_strains_by_id.get(condId);
    if (ref == null) {
        return null;
    }

    var s = *ref;
    var f = *s.family;

       println("nana oh oh");
    return Map<String, any?>{
        "condId"        : condId,
        "populationInit": s.populationInit,
        "populationMax" : s.populationMax,
        "familyName"    : f.name
    };

}





//var experiments_by_reactorId: nodeIndex<String, node<Experimentation>>;
var experiments_by_id: nodeIndex<String, node<Experimentation>>;
var experiments_by_reactorId: nodeIndex<String, nodeList<node<Experimentation>>>;

var experiments_keys: nodeList<String>;


@expose
fn experiment_save(experimentId: String, reactorId: String, condId: String, populationModel: String, phModel: String, tempModel: String, source: String) {

    var reactorRef = bioreactors_by_id.get(reactorId);
    if (reactorRef == null) {
        println("no bioreactor was found");
        return null;
    }

    var strainRef = initial_strains_by_id.get(condId);
    if (strainRef== null) {
        println("no strain init was found");
        return null;
    }

    var expNode = node<Experimentation>{Experimentation {
        reactor:         reactorRef,
        strain:          strainRef,
        states:          nodeTime<ExperimentationState>{},
        populationModel: populationModel,
        phModel:         phModel,
        tempModel:       tempModel,
        source:          source
    }};

    experiments_by_id.set(experimentId, expNode);
    experiments_keys.add(experimentId);


    var list = experiments_by_reactorId.get(reactorId);
    if (list == null) {
        var newList = nodeList<node<Experimentation>>{};
        newList.add(expNode);
        experiments_by_reactorId.set(reactorId, newList);
    } else {
        list.add(expNode);
    }
  //  experiments_by_reactorId.set(reactorId, node<Experimentation>{exp});
    println("Experiment created with id"+ experimentId);



}



@expose
fn experiment_state_save(experimentId: String, ph: float, temperature: float, population: float, mu: float,gammaPh: float, gammaTemp: float, growthStatus: String) {

     var expRef = experiments_by_id.get(experimentId);
     if (expRef == null ) {
        return null;
     }
    var statesRef = expRef->states;

    statesRef.setAt(time::now(), ExperimentationState {
            ph: ph, temperature: temperature,
            population: population, mu: mu,
            gammaPh: gammaPh, gammaTemp: gammaTemp,
            growthStatus: growthStatus
    });


    while (statesRef.size() > 500) {
        var oldest = statesRef.firstTime();
        if (oldest == null) { break; }
        statesRef.removeAt(oldest);
    }

   // println("exp state saved: " + experimentId);
   // println(statesRef.size());
//    expRef->states.setAt(time::now(), ExperimentationState {
//            ph: ph, temperature: temperature,
//            population: population, mu: mu,
//            gammaPh: gammaPh, gammaTemp: gammaTemp,
//            growthStatus: growthStatus
//    });
//
//
//    println("exp state are saved");

}


@expose
fn get_experiment_for_compute(experimentId: String): Map<String, any?>? {
    var expRef = experiments_by_id.get(experimentId);
    if (expRef == null) { return null; }
    var exp    = *expRef;
    var strain = *exp.strain;
    var family = *strain.family;

  //  println("yarabi khoya yadi bac");
    return Map<String, any?>{
        "populationModel": exp.populationModel,
        "phModel"        : exp.phModel,
        "tempModel"      : exp.tempModel,
        "populationInit" : strain.populationInit,
        "populationMax"  : strain.populationMax,
        "muMax"          : family.muMax,
        "latency"        : family.latency,
        "phMin"          : family.phMin,  "phOpt": family.phOpt,  "phMax": family.phMax,
        "tempMin"        : family.tempMin,"tempOpt":family.tempOpt,"tempMax":family.tempMax
    };
}




@expose
fn get_experiment_with_states(experimentId: String):  Map<String, any?>?{
    var expRef = experiments_by_id.get(experimentId);
    if (expRef == null) {
        return null;
    }

    var exp = *expRef;
    var reactor = *exp.reactor;

    return Map<String, any?>{
        "experimentId"   : experimentId,
        "reactorId"      : reactor.reactorId,
        "populationModel": exp.populationModel,
        "phModel"        : exp.phModel,
        "tempModel"      : exp.tempModel,
        "source"         : exp.source
    };
}



@expose
fn get_last_experiment_state(experimentId: String): Map<String, any?>? {
    var expRef = experiments_by_id.get(experimentId);
    if (expRef == null) { return null; }
    var exp = *expRef;

    var last = exp.states.last();
    if (last == null) { return null; }


    return Map<String, any?>{
        "ph"          : last.ph,
        "temperature" : last.temperature,
        "population"  : last.population,
        "mu"          : last.mu,
        "gammaPh"     : last.gammaPh,
        "gammaTemp"   : last.gammaTemp,
        "growthStatus": last.growthStatus
    };
}


@expose
fn get_experiment_states(experimentId: String): Array<Map<String, any?>>? {
    var expRef = experiments_by_id.get(experimentId);
    if (expRef == null) {
        return null;
    }

    var exp = *expRef;
    var stateList = Array<Map<String, any?>>{};

    for (t: time, s: ExperimentationState in exp.states) {
        var epochMs = (t - 0_time).to(DurationUnit::milliseconds);

        stateList.add(Map<String, any?>{
            "timestamp"   : epochMs,
            "ph"          : s.ph,
            "temperature": s.temperature,
            "population"  : s.population,
            "mu"         : s.mu,
            "gammaPh"     : s.gammaPh,
            "gammaTemp"  : s.gammaTemp,
            "growthStatus": s.growthStatus
        });
    }

    return stateList;
}

@expose
fn get_all_experiments(): Array<Map<String, any?>>? {
    var results = Array<Map<String, any?>>{};
    for (var i = 0; i < experiments_keys.size(); i++) {
        var key    = experiments_keys.get(i);
        var expRef = experiments_by_id.get(key);
        if (expRef == null) { continue; }
        var exp = *expRef;
        results.add(Map<String, any?>{
            "experimentId"   : key,
            "populationModel": exp.populationModel,
            "phModel"        : exp.phModel,
            "tempModel"      : exp.tempModel,
            "source"         : exp.source
        });
    }
    return results;
}